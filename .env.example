# ==============================================================================
# Central Configuration & Port Management (.env.example)
# Copy this file to .env and fill in your environment-specific credentials:
# cp .env.example .env
# ==============================================================================

# --- Kubernetes ---
# Set to the exact context name from: kubectl config current-context
EXPECTED_K8S_CONTEXT=do-blr1-k8s-1-22-8-do-1-blr1-1655977229480

# --- PostgreSQL (via PgBouncer port-forward) ---
PG_HOST=localhost
PG_PORT=6432
PG_DB=rpg
PG_USER=postgres
PG_PASSWORD=

# --- Web API ---
API_PORT=5000

# --- RavenDB Source ---
RAVEN_URL=https://a.free.btl.ravendb.cloud
RAVEN_DB=BTL
# Path is relative to the repo root (where migration commands are run from)
RAVEN_CERT_FILE=certs/free.btl.client.certificate.pfx
RAVEN_CERT_PASSWORD=

# --- Migration Tuning & Collection Names ---
PAGE_SIZE=500
TIMEOUT_SEC=30
PERSONAS_COLLECTION=Personas
COURSES_COLLECTION=Courses
STAFFS_COLLECTION=Staffs
ORG_COLLECTION=Orgs
INSTITUTE_COLLECTION=Institutes
STUDENT_COLLECTION=Students
FEES_COLLECTION=Fees
FEE_TXS_COLLECTION=FeeTxes
EXAMS_COLLECTION=Exams
