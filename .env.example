# ==============================================================================
# Central Configuration & Port Management (.env.example)
# Copy this file to .env and fill in your environment-specific credentials:
# cp .env.example .env
# ==============================================================================

# Target PostgreSQL Host Port (Port forwarding: 15432:5432 avoids standard 5432 collisions)
PG_PORT=15432

# ASP.NET Core Web API Host Port
API_PORT=5000

# PostgreSQL Target Settings
PG_HOST=localhost
PG_DB=rpg
PG_USER=postgres
PG_PASSWORD=YourSecurePasswordHere

# RavenDB Source Configuration
RAVEN_URL=https://<your-cluster-name>.ravendb.cloud
RAVEN_DB=rpg
RAVEN_CERT_FILE=certs/<your-client-cert>.pfx
RAVEN_CERT_PASSWORD=

# Migration Tuning & Collection Names
PAGE_SIZE=500
TIMEOUT_SEC=30

APPLICATION_FORM_TEMPLATES_COLLECTION=ApplicationFormTemplates
APPLICATIONS_COLLECTION=Applications
ARTEFACTS_COLLECTION=Artefacts
ARTEFACT_TAGS_COLLECTION=ArtefactTags
ASSESSMENTS_COLLECTION=Assessments
ASSESSMENT_TAGS_COLLECTION=AssessmentTags
ASSET_VIEWS_COLLECTION=AssetViews
ATTENDANCE_EVENTS_COLLECTION=AttendanceEvents
CALENDAR_RULES_COLLECTION=CalendarRules
CIRCULATION_VIEWS_COLLECTION=CirculationViews
COMMITS_COLLECTION=Commits
COMMIT_ACS_COLLECTION=CommitAcs
COMMIT_ASSETS_COLLECTION=CommitAssets
CONTENT_TAGS_COLLECTION=ContentTags
COURSES_COLLECTION=Courses
EMAILS_COLLECTION=Emails
EXAMS_COLLECTION=Exams
FEES_COLLECTION=Fees
FEE_TXS_COLLECTION=FeeTxes
GRADINGS_COLLECTION=Gradings
IMAGE_TAGS_COLLECTION=ImageTags
INSTITUTE_CALENDARS_COLLECTION=InstituteCalendars
INVENTORY_ITEM_VIEWS_COLLECTION=InventoryItemViews
INVENTORY_JOURNAL_VIEWS_COLLECTION=InventoryJournalViews
LEDGER_ACCOUNT_VIEWS_COLLECTION=LedgerAccountViews
MATERIAL_VIEWS_COLLECTION=MaterialViews
MEMBER_VIEWS_COLLECTION=MemberViews
ORG_COLLECTION=Orgs
INSTITUTE_COLLECTION=Institutes
STUDENT_COLLECTION=Students
PERSONAS_COLLECTION=Personas
QA_TAGS_COLLECTION=QATags
QUESTIONS_COLLECTION=Questions
RANDOM_QUESTION_SUBMISSIONS_COLLECTION=RandomQuestionSubmissions
RECEIPTS_COLLECTION=Receipts
SEAT_MATRICES_COLLECTION=SeatMatrices
